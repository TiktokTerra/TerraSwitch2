/* TerraSwitch 2 "Amethyst": deep purple, one violet accent, Inter. Colours live in the palette
   (fritchii_ui.cpp); this file shapes the widgets. */

QToolTip {
    background: #241c38;
    color: #ede9fb;
    border: 1px solid #322948;
    border-radius: 6px;
    padding: 6px 8px;
}

QMenuBar { background: #15101f; }
QMenuBar::item { padding: 6px 10px; background: transparent; border-radius: 6px; }
QMenuBar::item:selected { background: #241c38; }

QMenu {
    background: #201a2e;
    border: 1px solid #322948;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item { padding: 7px 30px 7px 14px; border-radius: 6px; }
QMenu::item:selected { background: #3d2f68; color: #ede9fb; }
QMenu::item:disabled { color: #6a5f96; }
QMenu::separator { height: 1px; background: #322948; margin: 5px 8px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }

QPushButton {
    background: #241c38;
    border: 1px solid #322948;
    border-radius: 8px;
    padding: 7px 18px;
}
QPushButton:hover { background: #2a2140; }
QPushButton:pressed { background: #322950; }
QPushButton:default { background: #b18cff; color: #1a0f38; border: 1px solid #b18cff; }
QPushButton:default:hover { background: #c4a8ff; }
QPushButton:disabled { color: #6a5f96; background: #1c1628; }

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit {
    background: #1c1628;
    border: 1px solid #322948;
    border-radius: 8px;
    padding: 6px 10px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #b18cff; }
QComboBox:hover, QLineEdit:hover { border-color: #433860; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(:/fritchii/icons/chevron-down.png); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #201a2e;
    border: 1px solid #322948;
    padding: 4px;
    outline: none;
    selection-background-color: #3d2f68;
    selection-color: #ede9fb;
}

QCheckBox, QRadioButton { spacing: 10px; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    border: 1px solid #433860;
    background: #1c1628;
}
QCheckBox::indicator:hover { border-color: #b18cff; }
QCheckBox::indicator:checked {
    background: #b18cff;
    border-color: #b18cff;
    image: url(:/fritchii/icons/check.png);
}
QCheckBox::indicator:disabled { background: #171126; border-color: #2a2140; }

QGroupBox {
    border: 1px solid #2c2440;
    border-radius: 12px;
    margin-top: 26px;
    padding: 14px 12px 10px 12px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    color: #a79ed6;
}

QTabWidget::pane { border: none; }
QTabBar::tab {
    background: transparent;
    color: #a79ed6;
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:hover { color: #ede9fb; }
QTabBar::tab:selected { color: #ede9fb; border-bottom: 2px solid #b18cff; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #3a2f58; border-radius: 4px; min-height: 32px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3a2f58; border-radius: 4px; min-width: 32px; margin: 2px; }
QScrollBar::handle:hover { background: #433860; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QHeaderView::section {
    background: #15101f;
    color: #a79ed6;
    border: none;
    border-bottom: 1px solid #2c2440;
    padding: 6px 10px;
}
QTreeView, QListView, QTableView { border: none; outline: none; }
QTreeView::item, QListView::item { padding: 4px; }
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: #3d2f68;
    color: #ede9fb;
}

QSlider::groove:horizontal { height: 4px; background: #322948; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #b18cff; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #ede9fb;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QProgressBar {
    background: #241c38;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #ede9fb;
}
QProgressBar::chunk { background: #b18cff; border-radius: 4px; }

QStatusBar { background: #0e0b16; color: #a79ed6; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #a79ed6; padding: 0 6px; }
QPushButton#TogglableStatusBarButton, QPushButton#DockingStatusBarButton,
QPushButton#OotFpsStatusBarButton, QPushButton#GPUStatusBarButton,
QPushButton#RendererStatusBarButton, QPushButton#RefreshButton {
    background: transparent;
    border: none;
    color: #a79ed6;
    padding: 3px 10px;
    border-radius: 6px;
}
QPushButton#TogglableStatusBarButton:hover, QPushButton#DockingStatusBarButton:hover,
QPushButton#OotFpsStatusBarButton:hover, QPushButton#GPUStatusBarButton:hover,
QPushButton#RendererStatusBarButton:hover, QPushButton#RefreshButton:hover {
    background: #241c38;
    color: #ede9fb;
}
QPushButton#OotFpsStatusBarButton { color: #b18cff; }

/* Settings sidebar */
QListWidget#selectorList { background: transparent; border: none; outline: none; }
QListWidget#selectorList::item { padding: 9px 14px; border-radius: 8px; margin: 1px 0; }
QListWidget#selectorList::item:hover { background: #201a2e; }
QListWidget#selectorList::item:selected { background: #3d2f68; color: #ede9fb; }

/* What's New and the update dialog */
QLabel#FritchiiDialogTitle { font-size: 24px; font-weight: 500; color: #ede9fb; }
QTextBrowser#FritchiiNotes { background: transparent; border: none; font-size: 15px; }

/* Preparing shaders (fritchii/precompile_gate.cpp) */
QDialog#FritchiiPrepare { background: #15101f; }
QLabel#FritchiiLead { font-size: 16px; color: #cfc8ec; }
QProgressBar#FritchiiPrepareBar { background: #241c38; border: none; border-radius: 6px; }
QProgressBar#FritchiiPrepareBar::chunk { background: #b18cff; border-radius: 6px; }
QLabel#FritchiiStatusNote { color: #b18cff; padding: 0 10px; }

/* In-game control strip (fritchii/game_controls.cpp) */
QToolButton#FritchiiStripButton { background: transparent; border: none; border-radius: 10px; }
QToolButton#FritchiiStripButton:hover { background: #3d2f68; }
QToolButton#FritchiiStripButton:pressed { background: #4d3d80; }

/* Home and rail (fritchii/home.cpp) */
QWidget#FritchiiRail { background: #0e0b16; }
QToolButton#FritchiiRailButton {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 10px;
}
QToolButton#FritchiiRailButton:hover { background: #201a2e; }
QToolButton#FritchiiRailButton:checked { background: #2b1f4a; }
QWidget#FritchiiHome { background: #15101f; }
QLabel#FritchiiHeroTitle { font-size: 30px; font-weight: 500; color: #ede9fb; }
QLabel#FritchiiSection { font-size: 14px; color: #a79ed6; }
QPushButton#FritchiiPlay {
    background: #b18cff;
    color: #1a0f38;
    border: none;
    border-radius: 8px;
    min-height: 44px;
    max-height: 44px;
    padding: 0 30px;
    font-size: 16px;
    font-weight: 500;
}
QPushButton#FritchiiLink {
    background: #201a2e;
    color: #ede9fb;
    border: none;
    border-radius: 8px;
    min-height: 38px;
    max-height: 38px;
    padding: 0 18px;
    font-size: 15px;
    font-weight: 500;
}
QPushButton#FritchiiLink:hover { background: #322852; }
QPushButton#FritchiiLink:pressed { background: #2b1f4a; }
QPushButton#FritchiiPlay:hover { background: #c4a8ff; }
QPushButton#FritchiiPlay:pressed { background: #9d6dff; }
QToolButton#FritchiiTile {
    background: transparent;
    border: none;
    border-radius: 12px;
    padding: 8px;
    color: #cfc8ec;
    font-size: 13px;
}
QToolButton#FritchiiTile:hover { background: #201a2e; color: #ede9fb; }
